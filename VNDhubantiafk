-- ULTRA BLACK SCREEN & MAX RAM/CPU CLEANER (FULL WIPECOUT)
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local VirtualUser = game:GetService("VirtualUser")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local LocalPlayer = Players.LocalPlayer

-- 1. TẠO MÀN HÌNH ĐEN TUYỆT ĐỐI (BLACK SCREEN OVERLAY)
local blackGui = Instance.new("ScreenGui")
blackGui.Name = "UltraBlackScreen"
blackGui.IgnoreGuiInset = true
blackGui.ResetOnSpawn = false
blackGui.DisplayOrder = 2147483647

local blackFrame = Instance.new("Frame", blackGui)
blackFrame.Size = UDim2.new(1, 0, 1, 0)
blackFrame.BackgroundColor3 = Color3.new(0, 0, 0)
blackFrame.BorderSizePixel = 0

-- Ưu tiên chèn vào CoreGui để không bị script khác làm mất màn đen
local targetParent = (gethui and gethui()) or game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")
blackGui.Parent = targetParent

-- 2. TẮT ÂM THANH & TẮT RENDER 3D & SIẾT FPS XUỐNG 5
SoundService.Volume = 0
pcall(function() RunService:Set3dRenderingEnabled(false) end)
if setfpscap then pcall(function() setfpscap(5) end) end

-- 3. TỰ ĐỘNG CHỐNG KICK AFK
LocalPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

task.spawn(function()
    while task.wait(300) do
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end
end)

-- 4. XÓA SẠCH PLAYER GUI (GIAO DIỆN GAME)
local function clearPlayerGui()
    local pgui = LocalPlayer:FindFirstChild("PlayerGui")
    if pgui then
        for _, gui in ipairs(pgui:GetChildren()) do
            if gui ~= blackGui then
                pcall(function() gui:Destroy() end)
            end
        end
    end
end
clearPlayerGui()

LocalPlayer.ChildAdded:Connect(function(c)
    if c.Name == "PlayerGui" then
        task.wait()
        for _, gui in ipairs(c:GetChildren()) do
            if gui ~= blackGui then pcall(function() gui:Destroy() end) end
        end
        c.ChildAdded:Connect(function(gui)
            if gui ~= blackGui then
                task.wait()
                pcall(function() gui:Destroy() end)
            end
        end)
    end
end)

-- 5. XÓA SẠCH MAP, TERRAIN & LIGHTING
Lighting:ClearAllChildren()
Lighting.GlobalShadows = false
Lighting.FogEnd = 0
Lighting.Brightness = 0
Lighting.Ambient = Color3.new(0, 0, 0)
Lighting.OutdoorAmbient = Color3.new(0, 0, 0)

pcall(function() Workspace.Terrain:Clear() end)

-- Hàm xóa triệt để mọi vật thể trong Workspace (giữ lại Camera)
local function sweepWorkspace(obj)
    if obj ~= Workspace.CurrentCamera then
        pcall(function() obj:Destroy() end)
    end
end

for _, v in ipairs(Workspace:GetChildren()) do
    sweepWorkspace(v)
end

-- Tự động diệt ngay các vật thể mới load vào Map
Workspace.ChildAdded:Connect(sweepWorkspace)

-- 6. GIẢM CẤP ĐỘ ĐỒ HỌA HỆ THỐNG XUỐNG MỨC THẤP NHẤT
pcall(function()
    local rendering = settings().Rendering
    rendering.QualityLevel = Enum.QualityLevel.Level01
    rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level01
end)

-- 7. ÉP DỌN BỘ NHỚ ĐỆM (GARBAGE COLLECTION) LIÊN TỤC MỖI 30 GIÂY
task.spawn(function()
    while task.wait(30) do
        collectgarbage("collect")
    end
end)
