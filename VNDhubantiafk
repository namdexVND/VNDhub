local blackGui = Instance.new("ScreenGui")
blackGui.Name = "SafeBlackScreen"
blackGui.IgnoreGuiInset = true
blackGui.ResetOnSpawn = false
blackGui.DisplayOrder = 2147483647

local blackFrame = Instance.new("Frame", blackGui)
blackFrame.Size = UDim2.new(1, 0, 1, 0)
blackFrame.BackgroundColor3 = Color3.new(0, 0, 0)
blackFrame.BorderSizePixel = 0

local targetParent = (gethui and gethui()) or game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")
blackGui.Parent = targetParent

local function toggleOptimization(enable)
    isOptimized = enable
    blackGui.Enabled = enable

    pcall(function()
        RunService:Set3dRenderingEnabled(not enable)
    end)

    if enable me then
        SoundService.Volume = 0
        if setfpscap then pcall(function() setfpscap(AFK_FPS) end) end
    else
        SoundService.Volume = originalVolume
        if setfpscap then pcall(function() setfpscap(NORMAL_FPS) end) end
    end
end

toggleOptimization(true)

-- NÚT BẬT/TẮT: BẤM PHÍM INSERT
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == TOGGLE_KEY then
        toggleOptimization(not isOptimized)
