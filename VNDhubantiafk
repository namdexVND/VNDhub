-- BẬT / TẮT TỐI ƯU
----------------------------------------------------
local function toggleOptimization(enable)
    isOptimized = enable

    if enable then
        -- 1. Hiện UI Đen lên trước
        blackGui.Enabled = true
        SoundService.Volume = 0
        if setfpscap then pcall(function() setfpscap(AFK_FPS) end) end
        
        -- 2. Chờ UI vẽ xong mới ngắt 3D Rendering
        task.delay(0.1, function()
            if isOptimized then
                pcall(function() RunService:Set3dRenderingEnabled(false) end)
            end
        end)
    else
        -- Bật lại 3D Rendering trước khi ẩn UI Đen
        pcall(function() RunService:Set3dRenderingEnabled(true) end)
        blackGui.Enabled = false
        SoundService.Volume = originalVolume
        if setfpscap then pcall(function() setfpscap(NORMAL_FPS) end) end
    end
end

-- Khởi chạy chế độ tối ưu khi load script
toggleOptimization(true)

-- NÚT BẬT/TẮT: BẤM PHÍM INSERT
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == TOGGLE_KEY then
        toggleOptimization(not isOptimized)
    end
end)
