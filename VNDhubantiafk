-- ULTRA RAM & CPU SAVER (HEADLESS AFK)
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local VirtualUser = game:GetService("VirtualUser")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

-- 1. TẮT HOÀN TOÀN RENDER 3D & GIẢM FPS TỐI ĐA (Tiết kiệm RAM & GPU cực lớn)
pcall(function() RunService:Set3dRenderingEnabled(false) end)
if setfpscap then pcall(function() setfpscap(10) end) end

-- 2. TỰ ĐỘNG CHỐNG KICK AFK
LocalPlayer.Idled:Connect(function()
    VirtualUser:CaptureController()
    VirtualUser:ClickButton2(Vector2.new())
end)

task.spawn(function()
    while task.wait(300) do
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end
end)

-- 3. XÓA SẠCH GIAO DIỆN (PlayerGui)
local function clearGui()
    local pgui = LocalPlayer:FindFirstChild("PlayerGui")
    if pgui then
        pgui:ClearAllChildren()
    end
end
clearGui()
LocalPlayer.ChildAdded:Connect(function(c)
    if c.Name == "PlayerGui" then
        task.wait()
        c:ClearAllChildren()
        c.ChildAdded:Connect(function(gui)
            task.wait()
            gui:Destroy()
        end)
    end
end)

-- 4. XÓA SẠCH BỘ NHỚ LIGHTING & TERRAIN
Lighting:ClearAllChildren()
Lighting.GlobalShadows = false
Lighting.FogEnd = 9e9
Lighting.Brightness = 0

pcall(function() Workspace.Terrain:Clear() end)

-- 5. HÀM XÓA SẠCH VẬT THỂ 3D, MESH, AM THANH, TEXTURE
local function destroyUnnecessary(v)
    if v:IsA("Decal") or v:IsA("Texture") or v:IsA("Sound") or v:IsA("SurfaceAppearance") 
    or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Smoke") 
    or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Highlight") or v:IsA("PostEffect") 
    or v:IsA("Atmosphere") or v:IsA("Sky") or v:IsA("SpecialMesh") then
        pcall(function() v:Destroy() end)
    elseif v:IsA("BasePart") then
        v.Material = Enum.Material.SmoothPlastic
        v.Reflectance = 0
        v.CastShadow = false
    end
end

-- Tẩy sạch Map hiện tại
for _, v in ipairs(Workspace:GetDescendants()) do
    destroyUnnecessary(v)
end

-- Tự động xóa vật thể mới xuất hiện
Workspace.DescendantAdded:Connect(destroyUnnecessary)

-- 6. TẨY TRANG PHỤC & PHỤ KIỆN NHÂN VẬT ĐỂ GIẢM RAM
local function cleanCharacter(char)
    if not char then return end
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("CharacterMesh") or v:IsA("BodyColors") or v:IsA("ShirtGraphic") then
            pcall(function() v:Destroy() end)
        end
    end
end

if LocalPlayer.Character then cleanCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(cleanCharacter)

-- 7. GIẢM THIỂU CHẤT LƯỢNG ĐỒ HỌA HỆ THỐNG
pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

-- 8. THU GOM RÁC BỘ NHỚ (GARBAGE COLLECTION) ĐỊNH KỲ
task.spawn(function()
    while task.wait(60) do
        collectgarbage("collect")
    end
end)
